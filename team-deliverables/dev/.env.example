# 必填：超级管理员访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me
# 推荐：TMDB 官方影视资料库 API Key（v3 密钥，用于获取 4K 海报、剧照与多维分类检索）
# TMDB_API_KEY=your_tmdb_api_key_here
# 可选：超级管理员自定义用户名（默认 admin，强烈建议自定义修改，提升安全性）
# ADMIN_USERNAME=my_super_admin
# ADMIN_PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：覆盖本地构建镜像的 tag（默认 cltv:local）。
# LIBRETV_IMAGE=registry.example.com/your-org/cltv:2.16.12

# 推荐：Neon Serverless PostgreSQL 主数据库（提高数据持久性与多用户并发读写）
# 在 Neon.tech 创建免费项目后获取连接串并填入 Render 环境变量（已内置自动防警告与兼容处理）
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true

# 可选：GitHub Gist 独立容灾冷备（不再承担日常读写，仅用于数据定期备份与灾难恢复）
# 填写具有 gist 权限的 GitHub Classic Personal Access Token (ghp_...)
# GITHUB_TOKEN=ghp_your_classic_token_here
# 可选：绑定已有的私有 Gist ID（如不填，系统会自动为您在 GitHub 创建专属私有容灾 Gist）
# GIST_ID=
